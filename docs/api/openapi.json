{
  "openapi": "3.1.1",
  "info": {
    "title": "MusicRoom.WebAPI | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "MusicRoom.WebAPI"
        ],
        "summary": "Liveness",
        "description": "Returns 200 while the process is serving. Touches no dependency.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "HealthEndpoints"
        ],
        "summary": "Readiness",
        "description": "Returns 200 when every dependency is reachable, 503 when one is not.",
        "operationId": "GetHealthReady",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/registrations": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Register an account",
        "description": "Accepts the registration and answers 202 whether or not the address is already registered. A 409 here would tell an anonymous caller who holds an account; the mailbox tells the real user what happened.",
        "operationId": "PostAuthRegistration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request"
          },
          "202": {
            "description": "Accepted"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/email-verifications": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Verify an email address",
        "description": "Spends the token from the verification mail exactly once and marks the address verified. The description says nothing about what separates 400 from 410 for a given token, because that is the caller's business only when they hold it.",
        "operationId": "PostAuthEmailVerification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "410": {
            "description": "Gone"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/verification-requests": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Ask for another email verification link",
        "description": "Answers 202 for any address that is a valid address. Whether a mail follows is not stated and cannot be inferred from the response: a distinct answer here would tell an anonymous caller which addresses hold a registered or confirmed account.",
        "operationId": "PostAuthVerificationRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request"
          },
          "202": {
            "description": "Accepted"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Sign in",
        "description": "Exchanges an address and a password for a token pair. Every failure — unknown address, wrong password, unverified account — answers the same bodiless 401, and the unknown-address path spends the same hashing work as the others, so the response cannot be timed either.",
        "operationId": "PostAuthSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request"
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      },
      "get": {
        "tags": [
          "SessionEndpoints"
        ],
        "summary": "List your own sessions",
        "description": "Lists the caller's live sessions, newest first, each with the platform, device and app version that started it so a session can be recognised. No token and no digest is returned: the list exists to be read, not to be replayed.",
        "operationId": "GetAuthSessions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/tokens": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Rotate a session",
        "description": "Spends a refresh token exactly once and returns a rotated pair. Presenting an already-rotated token revokes the whole family and answers 401: that is the session-theft detector, and it answers exactly as an unknown or expired token does.",
        "operationId": "PostAuthToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRotationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request"
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/password-reset-requests": {
      "post": {
        "tags": [
          "PasswordResetEndpoints"
        ],
        "summary": "Ask for a password reset link",
        "description": "Answers 202 for any address that is a valid address. Whether a mail follows is not stated and cannot be inferred from the response: a distinct answer here would tell an anonymous caller which addresses hold an account.",
        "operationId": "PostAuthPasswordResetRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request"
          },
          "202": {
            "description": "Accepted"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/password-resets": {
      "post": {
        "tags": [
          "PasswordResetEndpoints"
        ],
        "summary": "Replace a forgotten password",
        "description": "Spends the token from the reset mail exactly once, replaces the password and revokes every refresh token the account holds, so a password change ends every session opened with the old one. An access token issued moments earlier stays valid until it expires; that window is the 15 minutes the session design fixes. A 422 describes the new password only, never the token.",
        "operationId": "PostAuthPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "410": {
            "description": "Gone"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/sessions/current": {
      "delete": {
        "tags": [
          "SessionEndpoints"
        ],
        "summary": "Sign out",
        "description": "Revokes the refresh-token family this access token belongs to, named by its sid claim, so no token from this session can be rotated again. The access token already issued stays valid until it expires — at most 15 minutes and 30 seconds — which is the accepted window in the threat register rather than an oversight.",
        "operationId": "DeleteAuthCurrentSession",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/sessions/{sessionId}": {
      "delete": {
        "tags": [
          "SessionEndpoints"
        ],
        "summary": "End one of your sessions",
        "description": "Revokes one named session of the calling account. An unknown id, one already ended and one belonging to another account all answer 404, because a distinct answer would confirm that another account's session exists.",
        "operationId": "DeleteAuthSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "ProfileEndpoints"
        ],
        "summary": "Read your own profile",
        "description": "Returns every profile field with the visibility tier that governs it, plus the caller's music preferences. The owner is the one reader who sees every tier; what another user sees is projected per field, which is a different endpoint.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/me/profile": {
      "patch": {
        "tags": [
          "ProfileEndpoints"
        ],
        "summary": "Update your own profile",
        "description": "Updates any subset of the profile. Each field carries its value and its visibility tier in the same object, so a field cannot exist without a tier — a value with no tier is 422, never a silent default to public. An absent field is left untouched; sending a null value with a tier clears it.",
        "operationId": "PatchMeProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/music-preferences": {
      "put": {
        "tags": [
          "ProfileEndpoints"
        ],
        "summary": "Replace your music preferences",
        "description": "Replaces the whole preference set, genres and artists. Preferences are private to their owner and carry no visibility tier of their own. Both lists are bounded: an unbounded array behind an authenticated endpoint is unrestricted resource consumption.",
        "operationId": "PutMeMusicPreferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MusicPreferencesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmailVerificationRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the verification mail."
          }
        },
        "description": "The email verification payload — `docs/api/ENDPOINTS.md` §1."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MusicPreferencesRequest": {
        "required": [
          "genres",
          "artists"
        ],
        "type": "object",
        "properties": {
          "genres": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "The genres the user names."
          },
          "artists": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "The artists the user names."
          }
        },
        "description": "The music preferences payload — `docs/api/ENDPOINTS.md` §2."
      },
      "OwnProfileResponse": {
        "required": [
          "displayName",
          "realName",
          "bio",
          "location",
          "birthDate",
          "genres",
          "artists"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "The handle the account is known by. Always public."
          },
          "realName": {
            "description": "The real name and its tier.",
            "$ref": "#/components/schemas/ProfileFieldResponseOfstring"
          },
          "bio": {
            "description": "The bio and its tier.",
            "$ref": "#/components/schemas/ProfileFieldResponseOfstring"
          },
          "location": {
            "description": "The location and its tier.",
            "$ref": "#/components/schemas/ProfileFieldResponseOfstring"
          },
          "birthDate": {
            "description": "The date of birth and its tier.",
            "$ref": "#/components/schemas/ProfileFieldDateResponse"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The genres the user named."
          },
          "artists": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The artists the user named."
          }
        },
        "description": "A profile as its owner reads it."
      },
      "PasswordResetRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address to send a reset link to."
          }
        },
        "description": "The reset request payload — `docs/api/ENDPOINTS.md` §1."
      },
      "PasswordResetSubmission": {
        "required": [
          "token",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the reset mail."
          },
          "newPassword": {
            "type": "string",
            "description": "The replacement password. Never logged or echoed back."
          }
        },
        "description": "The reset payload — `docs/api/ENDPOINTS.md` §1."
      },
      "ProfileDateFieldRequest": {
        "required": [
          "value",
          "visibility"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "null",
              "string"
            ],
            "description": "The date, or null to clear the field.",
            "format": "date"
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Who may see it. Absent means `422`.",
                "$ref": "#/components/schemas/ProfileFieldVisibility"
              }
            ]
          }
        },
        "description": "The date-of-birth field as a client sends it."
      },
      "ProfileFieldDateResponse": {
        "required": [
          "value",
          "visibility"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "null",
              "string"
            ],
            "description": "The date, or null when the field is empty.",
            "format": "date"
          },
          "visibility": {
            "description": "Who may see it.",
            "$ref": "#/components/schemas/ProfileFieldVisibility"
          }
        },
        "description": "The date-of-birth field and its tier."
      },
      "ProfileFieldRequestOfstring": {
        "required": [
          "value",
          "visibility"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "null",
              "string"
            ],
            "description": "The value, or null to clear the field."
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Who may see it. Absent means `422`: the binder would otherwise default a missing\n    enum to its zero value, which is `Public` — the exact silent default `docs/api/ENDPOINTS.md` forbids.",
                "$ref": "#/components/schemas/ProfileFieldVisibility"
              }
            ]
          }
        },
        "description": "One field as a client sends it: a value and a tier that is **optional on the wire so its absence can be\nrefused**."
      },
      "ProfileFieldResponseOfstring": {
        "required": [
          "value",
          "visibility"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "null",
              "string"
            ],
            "description": "The value, or null when the field is empty."
          },
          "visibility": {
            "description": "Who may see it.",
            "$ref": "#/components/schemas/ProfileFieldVisibility"
          }
        },
        "description": "One field's value and the tier that governs it."
      },
      "ProfileFieldVisibility": {
        "type": "integer",
        "description": "Who may see one profile field — subject V.1's three tiers, SDD §6.2."
      },
      "RegistrationRequest": {
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address to register."
          },
          "password": {
            "type": "string",
            "description": "The plaintext password, 12 to 64 characters and at most 72 UTF-8 bytes."
          },
          "displayName": {
            "type": "string",
            "description": "The name other users see."
          }
        },
        "description": "The registration payload — `docs/api/ENDPOINTS.md` §1."
      },
      "SessionRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address the account is known by."
          },
          "password": {
            "type": "string",
            "description": "The plaintext password. Never logged or echoed back."
          }
        },
        "description": "The sign-in payload — `docs/api/ENDPOINTS.md` §1."
      },
      "SessionResponse": {
        "required": [
          "sessionId",
          "platform",
          "device",
          "appVersion",
          "startedAt",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "The id to pass to `DELETE /auth/sessions/{sessionId}`.",
            "format": "uuid"
          },
          "platform": {
            "type": "string",
            "description": "The client platform that started the session."
          },
          "device": {
            "type": "string",
            "description": "The device that started it."
          },
          "appVersion": {
            "type": "string",
            "description": "The app version that started it."
          },
          "startedAt": {
            "type": "string",
            "description": "When the session began.",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "description": "When it stops being renewable.",
            "format": "date-time"
          }
        },
        "description": "One session, as a client reads it — `docs/api/ENDPOINTS.md` §1."
      },
      "TokenPairResponse": {
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "The signed, short-lived JWT."
          },
          "refreshToken": {
            "type": "string",
            "description": "The opaque refresh token, to be presented to\n    `POST /auth/tokens`. The server keeps only its digest."
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The access token's lifetime in seconds, for the client's own planning.",
            "format": "int32"
          }
        },
        "description": "The token pair both session endpoints answer with — `docs/api/ENDPOINTS.md` §1."
      },
      "TokenRotationRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token issued by the previous exchange."
          }
        },
        "description": "The rotation payload — `docs/api/ENDPOINTS.md` §1."
      },
      "UpdateProfileRequest": {
        "required": [
          "realName",
          "bio",
          "location",
          "birthDate"
        ],
        "type": "object",
        "properties": {
          "realName": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The real name and its tier, or absent to leave the field alone.",
                "$ref": "#/components/schemas/ProfileFieldRequestOfstring"
              }
            ]
          },
          "bio": {
            "oneOf": [

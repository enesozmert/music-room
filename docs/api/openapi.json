{
  "openapi": "3.1.1",
  "info": {
    "title": "MusicRoom.WebAPI | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "MusicRoom.WebAPI"
        ],
        "summary": "Liveness",
        "description": "Returns 200 while the process is serving. Touches no dependency.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "HealthEndpoints"
        ],
        "summary": "Readiness",
        "description": "Returns 200 when every dependency is reachable, 503 when one is not.",
        "operationId": "GetHealthReady",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/registrations": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Register an account",
        "description": "Accepts the registration and answers 202 whether or not the address is already registered. A 409 here would tell an anonymous caller who holds an account; the mailbox tells the real user what happened.",
        "operationId": "PostAuthRegistration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/email-verifications": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Verify an email address",
        "description": "Spends the token from the verification mail exactly once and marks the address verified. The description says nothing about what separates 400 from 410 for a given token, because that is the caller's business only when they hold it.",
        "operationId": "PostAuthEmailVerification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "410": {
            "description": "Gone"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/verification-requests": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Ask for another email verification link",
        "description": "Answers 202 for any address that is a valid address. Whether a mail follows is not stated and cannot be inferred from the response: a distinct answer here would tell an anonymous caller which addresses hold a registered or confirmed account.",
        "operationId": "PostAuthVerificationRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Sign in",
        "description": "Exchanges an address and a password for a token pair. Every failure — unknown address, wrong password, unverified account — answers the same bodiless 401, and the unknown-address path spends the same hashing work as the others, so the response cannot be timed either.",
        "operationId": "PostAuthSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/auth/tokens": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "summary": "Rotate a session",
        "description": "Spends a refresh token exactly once and returns a rotated pair. Presenting an already-rotated token revokes the whole family and answers 401: that is the session-theft detector, and it answers exactly as an unknown or expired token does.",
        "operationId": "PostAuthToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRotationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmailVerificationRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the verification mail."
          }
        },
        "description": "The email verification payload — `docs/api/ENDPOINTS.md` §1."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "RegistrationRequest": {
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address to register."
          },
          "password": {
            "type": "string",
            "description": "The plaintext password, 12 to 64 characters and at most 72 UTF-8 bytes."
          },
          "displayName": {
            "type": "string",
            "description": "The name other users see."
          }
        },
        "description": "The registration payload — `docs/api/ENDPOINTS.md` §1."
      },
      "SessionRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address the account is known by."
          },
          "password": {
            "type": "string",
            "description": "The plaintext password. Never logged or echoed back."
          }
        },
        "description": "The sign-in payload — `docs/api/ENDPOINTS.md` §1."
      },
      "TokenPairResponse": {
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "The signed, short-lived JWT."
          },
          "refreshToken": {
            "type": "string",
            "description": "The opaque refresh token, to be presented to\n    `POST /auth/tokens`. The server keeps only its digest."
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The access token's lifetime in seconds, for the client's own planning.",
            "format": "int32"
          }
        },
        "description": "The token pair both session endpoints answer with — `docs/api/ENDPOINTS.md` §1."
      },
      "TokenRotationRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token issued by the previous exchange."
          }
        },
        "description": "The rotation payload — `docs/api/ENDPOINTS.md` §1."
      },
      "VerificationRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address to send another verification link to."
          }
        },
        "description": "The verification resend payload — `docs/api/ENDPOINTS.md` §1."
      }
    }
  },
  "tags": [
    {
      "name": "MusicRoom.WebAPI"
    },
    {
      "name": "HealthEndpoints"
    },
    {
      "name": "AuthEndpoints"
    }
  ]
}
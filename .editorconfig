# music-room — single formatting and analysis authority.
# Rules: docs/technical-guide/10-backend/dotnet-csharp/STANDARD.md
# Decision: brain/decisions/ADR-0009-code-quality-gates.md
#
# Do not lower a severity here to make a build pass. Fix the code, or change the limit
# through an ADR.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4

# ---- language conventions (Microsoft) ----
csharp_style_namespace_declarations = file_scoped:error
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:suggestion

# ---- naming: Microsoft conventions, enforced as errors ----
dotnet_diagnostic.IDE1006.severity = error

dotnet_naming_rule.types_pascal.symbols = type_symbols
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,delegate,namespace,method,property,event
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.interfaces_i_prefixed.symbols = interface_symbols
dotnet_naming_rule.interfaces_i_prefixed.style = i_prefixed
dotnet_naming_rule.interfaces_i_prefixed.severity = error
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.capitalization = pascal_case
dotnet_naming_style.i_prefixed.required_prefix = I

dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.locals_camel.symbols = local_symbols
dotnet_naming_rule.locals_camel.style = camel_case_style
dotnet_naming_rule.locals_camel.severity = error
dotnet_naming_symbols.local_symbols.applicable_kinds = parameter,local
dotnet_naming_style.camel_case_style.capitalization = camel_case

dotnet_naming_rule.async_methods_suffixed.symbols = async_method_symbols
dotnet_naming_rule.async_methods_suffixed.style = async_suffix
dotnet_naming_rule.async_methods_suffixed.severity = warning
dotnet_naming_symbols.async_method_symbols.applicable_kinds = method
dotnet_naming_symbols.async_method_symbols.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

# ---- size and complexity limits ----
# Microsoft analyzers: complexity, maintainability, coupling.
dotnet_diagnostic.CA1502.severity = error              # excessive complexity
dotnet_code_quality.CA1502.threshold = 10
dotnet_diagnostic.CA1505.severity = warning            # maintainability index
dotnet_diagnostic.CA1506.severity = error              # excessive class coupling
dotnet_code_quality.CA1506.threshold = 30

# SonarAnalyzer.CSharp: line counts and member counts, which CA rules cannot express.
#
# Severities live here. The numeric THRESHOLDS live in MusicRoom/SonarLint.xml, because
# SonarAnalyzer reads rule parameters only through the Roslyn AdditionalFiles mechanism.
# `sonar.csharp.*` keys in this file are silently ignored: they were here until 2026-09-24, and
# S138 fired at its own default of 80 lines the whole time. Change a threshold in SonarLint.xml.
dotnet_diagnostic.S138.severity = error                # method has too many lines (40)
dotnet_diagnostic.S1541.severity = error               # cyclomatic complexity (10)
dotnet_diagnostic.S107.severity = error                # too many parameters (5)
dotnet_diagnostic.S134.severity = error                # nesting too deep (3)
dotnet_diagnostic.S1448.severity = error               # too many methods in a type (15)
dotnet_diagnostic.S104.severity = error                # file has too many lines (300)
dotnet_diagnostic.S1200.severity = warning             # class coupling (30)

# `TreatWarningsAsErrors` is on for every project, so a `warning` severity here fails the build
# exactly like `error`. The distinction above is documentary: it records which rules the project
# would drop to a warning if that property were ever relaxed. To make a rule genuinely
# non-blocking, use `suggestion` or `none` — not `warning`.

# ---- correctness rules escalated ----
dotnet_diagnostic.CA2007.severity = none               # ConfigureAwait: not needed in ASP.NET Core
dotnet_diagnostic.CA1062.severity = warning            # validate public arguments
dotnet_diagnostic.CA2100.severity = error              # SQL injection risk
dotnet_diagnostic.CA5350.severity = error              # weak cryptographic algorithm
dotnet_diagnostic.CA5351.severity = error              # broken cryptographic algorithm
dotnet_diagnostic.CA3075.severity = error              # insecure DTD processing
dotnet_diagnostic.CA5359.severity = error              # do not disable certificate validation

# ---- tests: length limits relaxed, security rules are not ----
# A long arrange block in a fixture is not the defect S138 and S104 exist to catch.
#
# Measured 2026-09-27: SonarAnalyzer already skips these rules in any project it recognises as a
# test project, and `IsTestProject` is true for all three. A 47-line method in
# MusicRoom.Application.Tests produced no S138 at `error`, `warning` or `suggestion`. This block
# is therefore a declaration of intent, and the safety net for a test project that is ever not
# recognised as one. `suggestion` is what makes it a real relaxation: `TreatWarningsAsErrors` is
# on, so `warning` would fail the build exactly like `error`.
[**/*Tests/**/*.cs]
dotnet_diagnostic.S138.severity = suggestion
dotnet_diagnostic.S1448.severity = none
dotnet_diagnostic.S104.severity = suggestion

# Copy to .env and fill in. .env is git-ignored — never commit real values.
# See docs/technical-guide/40-security/secrets-management/STANDARD.md
# Bring-up sequence: brain/decisions/ADR-0026-environment-bring-up.md

# --- Database ---------------------------------------------------------------
# Connection strings MUST stay quoted. `make migrate` sources this file with `. ./.env`,
# and an unquoted `;` would end the shell statement, silently truncating the value.
# Vendor-neutral on purpose. S0-S3: the local docker compose container.
# S4 onward: Supabase Free tier, Frankfurt (pooled + direct strings).
DATABASE_URL="Host=localhost;Port=5432;Database=musicroom;Username=musicroom;Password="
# Used by `dotnet ef` only. Migrations must NOT run through a transaction pooler.
DATABASE_DIRECT_URL="Host=localhost;Port=5432;Database=musicroom;Username=musicroom;Password="

# --- Local PostgreSQL container ---------------------------------------------
# Used by `docker compose` to initialise the db service. DATABASE_URL above is what the
# application reads; these three are what the container is created with, and they must agree.
# Not used once DATABASE_URL points at Supabase (S4 onward).
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=
POSTGRES_DB=musicroom
# Host port for the db container. Change it if something else already holds 5432 on your
# machine; the container port and the compose-internal DATABASE_URL are unaffected.
POSTGRES_HOST_PORT=5432

# --- Auth -------------------------------------------------------------------
JWT_SIGNING_KEY=
JWT_ISSUER=musicroom
JWT_AUDIENCE=musicroom-clients
JWT_ACCESS_TOKEN_MINUTES=15
BCRYPT_WORK_FACTOR=12

# --- Credential rate limits (SPEC-006, owner decision 2026-09-27) -------------
# The approved numbers are compiled in as defaults, so a host with no override still limits at what
# was signed off. These keys tighten or loosen them; a non-positive value is ignored, because the one
# outcome configuration must not produce is no limit at all. Seconds for the per-IP windows.
# RATE_LIMIT_SESSIONS_PERMITS=20
# RATE_LIMIT_SESSIONS_WINDOW_SECONDS=300
# RATE_LIMIT_TOKENS_PERMITS=60
# RATE_LIMIT_TOKENS_WINDOW_SECONDS=300
# RATE_LIMIT_REGISTRATIONS_PERMITS=10
# RATE_LIMIT_REGISTRATIONS_WINDOW_SECONDS=3600
# RATE_LIMIT_VERIFICATION_REQUESTS_PERMITS=10
# RATE_LIMIT_VERIFICATION_REQUESTS_WINDOW_SECONDS=3600
# RATE_LIMIT_EMAIL_VERIFICATIONS_PERMITS=30
# RATE_LIMIT_EMAIL_VERIFICATIONS_WINDOW_SECONDS=300
# RATE_LIMIT_PASSWORD_RESET_REQUESTS_PERMITS=10
# RATE_LIMIT_PASSWORD_RESET_REQUESTS_WINDOW_SECONDS=3600
# RATE_LIMIT_PASSWORD_RESETS_PERMITS=30
# RATE_LIMIT_PASSWORD_RESETS_WINDOW_SECONDS=300
# Changing a password while signed in — SPEC-028. Tighter than sign-in's twenty: the route needs a
# valid token to reach, and a person changes a password once.
# RATE_LIMIT_PASSWORD_CHANGES_PERMITS=10
# RATE_LIMIT_PASSWORD_CHANGES_WINDOW_SECONDS=300
# Per-account half: failures per window, the window in minutes, and the penalty ceiling in windows.
# RATE_LIMIT_ACCOUNT_PERMITS=5
# RATE_LIMIT_ACCOUNT_WINDOW_MINUTES=5
# RATE_LIMIT_ACCOUNT_MAX_PENALTY_WINDOWS=8

# --- Social login (needed at slice S8) --------------------------------------
# A provider is a row of four values — ADR-0008's amendment, SPEC-041. The discovery URL and the issuer
# are configuration rather than constants so that adding a second provider needs no code change, and so
# that no absolute URL is compiled into the binary.
#
# Leave any of the four empty and the provider is simply absent: the host boots, password sign-in works,
# and POST /auth/sessions/social answers "no provider is configured under that name".
#
# The client is a **Web** OAuth client, because this API exchanges the authorization code itself with the
# secret below — the client never holds it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_ISSUER=https://accounts.google.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Music provider (needed at slice S4) ------------------------------------
# ADR-0003: YouTube Data API v3, server-side only. A key in a client bundle is both a quota leak and,
# per the subject, a failing condition. SPEC-025 implements the adapter.
#
# With no key the API still answers from its two cache levels and reports the catalog unavailable
# (503) rather than failing to start: a provider outage must not stop an event, and a host with no
# key is the same situation.
YOUTUBE_API_KEY=

# How long the catalog's two caches keep an entry, in whole hours. Both default to ADR-0023's policy
# — 720 hours (30 days) for a track's metadata, which barely changes, and 6 hours for a search
# ranking, so a video uploaded this morning can be found today. A non-positive value is ignored,
# because configuration must not be able to switch a cache off and send every read to the provider.
# CATALOG_TRACK_LIFETIME_HOURS=720
# CATALOG_SEARCH_LIFETIME_HOURS=6

# --- Transactional mail (needed at slice S1) --------------------------------
# ADR-0013: hosted provider free tier, behind IMailService. SPEC-024 implements it.
#
# MAIL_PROVIDER decides which sender the host registers, and the application does not start without
# a valid one:
#   brevo   - the hosted provider. Requires MAIL_API_KEY and MAIL_FROM.
#             MAIL_API_KEY is Brevo's **v3 API key**, which starts `xkeysib-`. The adapter calls the
#             REST API at POST /v3/smtp/email; an SMTP key (`xsmtpsib-`) is for the SMTP relay only
#             and that endpoint answers 401 to it. Panel: SMTP & API -> API keys, not SMTP keys.
#   logging - writes the verification link and the reset token to the application log. Development
#             hosts only; any other environment refuses to start with it (threat T-26).
#
# MAIL_FROM must be a Brevo-verified sender or Brevo's sandbox sender. The sandbox sender is what
# this project uses, which ADR-0013 permits as long as it is said rather than presented as
# production — see docs/SDD.md 10.1.
MAIL_PROVIDER=logging
MAIL_API_KEY=
MAIL_FROM=
# Optional display name on the message. The provider shows the address when it is empty.
MAIL_FROM_NAME=

# Where the client serves the two screens the mailed links point at. Both are optional: with neither
# set, a message carries the bare token and says what to do with it. Nothing substitutes a default,
# because a link to a machine nobody intended is worse than no link.
VERIFICATION_LINK_BASE_URL=
PASSWORD_RESET_LINK_BASE_URL=

# --- Observability ----------------------------------------------------------
# ADR-0022: exporter is off by default; switch on for a load run.
OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Runtime ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Comma-separated list of browser origins. It governs REST **and** the SignalR handshake, because
# ADR-0030 refused a second allowlist for the hub: two lists drift, one does not. SPEC-026 wired it
# up — before that it was read by nothing.
#
# An empty value allows **no** cross-origin request. A request with no Origin header at all passes,
# which is the React Native client: it is not a browser and sends none. That hole is deliberate and
# the JWT is the control behind it.
CORS_ALLOWED_ORIGINS=

# --- Realtime limits (ADR-0030, numbers set 2026-10-04) ----------------------
# Concurrent connections per account, concurrent connections per address, and hub invocations per
# minute per connection. The values below are the defaults; a non-positive override is ignored, so
# configuration can raise or lower a ceiling and cannot switch one off.
# HUB_CONNECTIONS_PER_USER=5
# HUB_CONNECTIONS_PER_IP=20
# HUB_INVOCATIONS_PER_MINUTE=60

# --- The secret vault (needed only for `make vault`) -------------------------
# ADR-0029 made a self-hosted Infisical required scope. It runs behind a compose profile, so
# `make up` never starts it and a defence demo stays two services — SPEC-042.
#
# Generate the two secrets once and keep them. **Losing INFISICAL_ENCRYPTION_KEY loses every
# secret in the vault**; there is no recovery path and that is the design.
#
#   openssl rand -hex 16      -> INFISICAL_ENCRYPTION_KEY
#   openssl rand -base64 32   -> INFISICAL_AUTH_SECRET
#
# The vault keeps its own PostgreSQL and Redis, separate from the application's: one backup and
# one migration should not cover both the secret store and the user data.
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_REDIS_PASSWORD=

# 8090 because the API holds 8080.
INFISICAL_HOST_PORT=8090
INFISICAL_SITE_URL=http://localhost:8090

# --- Which provider the application reads through (SPEC-047) -----------------
# `env` is the default and reads this file through the process environment. `infisical` reads from
# the vault below, with this file as the floor underneath it — a name the vault holds comes from the
# vault, a name it does not falls through to here.
#
# Two things worth knowing before switching it on:
#   * **A vault that cannot be reached stops the application.** Nothing falls back to this file on
#     purpose: a vault outage must not quietly return the system to reading secrets out of a file.
#   * **Secrets are read once, at start-up.** Rotating one in the vault takes effect on the next
#     restart, which for a container is `docker compose restart api`.
#
# A value that is neither `env` nor `infisical` stops start-up rather than defaulting, so a typo
# here is never a vault nobody noticed was unused.
SECRET_PROVIDER=env

# --- What the application reads from the vault (SPEC-047) --------------------
# The machine identity created in the Infisical UI. These are the vault's bootstrap credentials,
# and they are the reason .env does not disappear: a vault shrinks the local secret file, it does
# not remove it — ADR-0029 said so before it was built.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# --- The OpenID Provider's signing key (needed at slice S8) ------------------
# ADR-0031 made this API an OpenID Provider, which means it signs identity tokens with RS256 and
# publishes the public half at /.well-known/jwks.json. A shared secret cannot be published in a
# JWKS, which is why HMAC is not an option here.
#
# This project never generates its own key: a generated key is one nobody backed up, nobody can
# rotate, and nothing else can verify against after a restart. Print one and paste it:
#
#   make oidc-key
#
# Rotating, with an overlap so tokens already in flight keep verifying — issue O19:
#   1. move the current value into OIDC_SIGNING_KEY_PREVIOUS
#   2. put a fresh `make oidc-key` value into OIDC_SIGNING_KEY
#   3. clear OIDC_SIGNING_KEY_PREVIOUS once nothing it signed is still alive
OIDC_SIGNING_KEY=
OIDC_SIGNING_KEY_PREVIOUS=

# --- The client this provider issues codes to (slice S8) ---------------------
# A client is a row of configuration, not a table — SPEC-044. Nobody can self-register with this
# provider: the authorization endpoint takes a bearer access token, so the deployment is
# first-party (ADR-0031's amendment of 2026-10-11) and the registry is the list of clients this
# deployment ships.
#
# OIDC_CLIENT_REDIRECT_URIS is exhaustive and matched exactly — no prefixes, no wildcards. A
# registry that matched prefixes would make this provider an open redirector for anything under a
# registered path. Separate several with commas or spaces.
#
# Leaving both empty is allowed: the API boots, password and social sign-in work, and every
# authorization request answers 400 CLIENT.UNKNOWN, which is the honest answer for a host with no
# client.
OIDC_CLIENT_ID=
OIDC_CLIENT_REDIRECT_URIS=

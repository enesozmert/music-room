# Copy to .env and fill in. .env is git-ignored — never commit real values.
# See docs/technical-guide/40-security/secrets-management/STANDARD.md
# Bring-up sequence: brain/decisions/ADR-0026-environment-bring-up.md

# --- Database ---------------------------------------------------------------
# Connection strings MUST stay quoted. `make migrate` sources this file with `. ./.env`,
# and an unquoted `;` would end the shell statement, silently truncating the value.
# Vendor-neutral on purpose. S0-S3: the local docker compose container.
# S4 onward: Supabase Free tier, Frankfurt (pooled + direct strings).
DATABASE_URL="Host=localhost;Port=5432;Database=musicroom;Username=musicroom;Password="
# Used by `dotnet ef` only. Migrations must NOT run through a transaction pooler.
DATABASE_DIRECT_URL="Host=localhost;Port=5432;Database=musicroom;Username=musicroom;Password="

# --- Local PostgreSQL container ---------------------------------------------
# Used by `docker compose` to initialise the db service. DATABASE_URL above is what the
# application reads; these three are what the container is created with, and they must agree.
# Not used once DATABASE_URL points at Supabase (S4 onward).
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=
POSTGRES_DB=musicroom
# Host port for the db container. Change it if something else already holds 5432 on your
# machine; the container port and the compose-internal DATABASE_URL are unaffected.
POSTGRES_HOST_PORT=5432

# --- Auth -------------------------------------------------------------------
JWT_SIGNING_KEY=
JWT_ISSUER=musicroom
JWT_AUDIENCE=musicroom-clients
JWT_ACCESS_TOKEN_MINUTES=15
BCRYPT_WORK_FACTOR=12

# --- Credential rate limits (SPEC-006, owner decision 2026-09-27) -------------
# The approved numbers are compiled in as defaults, so a host with no override still limits at what
# was signed off. These keys tighten or loosen them; a non-positive value is ignored, because the one
# outcome configuration must not produce is no limit at all. Seconds for the per-IP windows.
# RATE_LIMIT_SESSIONS_PERMITS=20
# RATE_LIMIT_SESSIONS_WINDOW_SECONDS=300
# RATE_LIMIT_TOKENS_PERMITS=60
# RATE_LIMIT_TOKENS_WINDOW_SECONDS=300
# RATE_LIMIT_REGISTRATIONS_PERMITS=10
# RATE_LIMIT_REGISTRATIONS_WINDOW_SECONDS=3600
# RATE_LIMIT_VERIFICATION_REQUESTS_PERMITS=10
# RATE_LIMIT_VERIFICATION_REQUESTS_WINDOW_SECONDS=3600
# RATE_LIMIT_EMAIL_VERIFICATIONS_PERMITS=30
# RATE_LIMIT_EMAIL_VERIFICATIONS_WINDOW_SECONDS=300
# RATE_LIMIT_PASSWORD_RESET_REQUESTS_PERMITS=10
# RATE_LIMIT_PASSWORD_RESET_REQUESTS_WINDOW_SECONDS=3600
# RATE_LIMIT_PASSWORD_RESETS_PERMITS=30
# RATE_LIMIT_PASSWORD_RESETS_WINDOW_SECONDS=300
# Changing a password while signed in — SPEC-028. Tighter than sign-in's twenty: the route needs a
# valid token to reach, and a person changes a password once.
# RATE_LIMIT_PASSWORD_CHANGES_PERMITS=10
# RATE_LIMIT_PASSWORD_CHANGES_WINDOW_SECONDS=300
# Per-account half: failures per window, the window in minutes, and the penalty ceiling in windows.
# RATE_LIMIT_ACCOUNT_PERMITS=5
# RATE_LIMIT_ACCOUNT_WINDOW_MINUTES=5
# RATE_LIMIT_ACCOUNT_MAX_PENALTY_WINDOWS=8

# --- Social login (needed at slice S8) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Music provider (needed at slice S4) ------------------------------------
# ADR-0003: YouTube Data API v3, server-side only. A key in a client bundle is both a quota leak and,
# per the subject, a failing condition. SPEC-025 implements the adapter.
#
# With no key the API still answers from its two cache levels and reports the catalog unavailable
# (503) rather than failing to start: a provider outage must not stop an event, and a host with no
# key is the same situation.
YOUTUBE_API_KEY=

# How long the catalog's two caches keep an entry, in whole hours. Both default to ADR-0023's policy
# — 720 hours (30 days) for a track's metadata, which barely changes, and 6 hours for a search
# ranking, so a video uploaded this morning can be found today. A non-positive value is ignored,
# because configuration must not be able to switch a cache off and send every read to the provider.
# CATALOG_TRACK_LIFETIME_HOURS=720
# CATALOG_SEARCH_LIFETIME_HOURS=6

# --- Transactional mail (needed at slice S1) --------------------------------
# ADR-0013: hosted provider free tier, behind IMailService.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=

# --- Observability ----------------------------------------------------------
# ADR-0022: exporter is off by default; switch on for a load run.
OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Runtime ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=

# secrets — subject V.8: committed credentials fail the project
.env
.env.*
!.env.example
*.pem
*.key

# macOS
.DS_Store

# .NET
bin/
obj/
*.user

# node / React Native
node_modules/
MusicRoomApp/ios/Pods/
MusicRoomApp/android/build/
MusicRoomApp/android/.gradle/
*.keystore
!debug.keystore

# vendored reference repo (own git history, study material only)
reference/

# agent run artifacts and controls — transient, never committed.
# STOP must be ignored: an untracked control file makes the tree dirty, and the driver
# refuses to start on a dirty tree, so pulling the cord would jam the next run.
.agent/runs/
.agent/STOP
.agent/.lock
.agent/*.local
# land-stack.sh works in a git worktree here. It is inside the repository on purpose — one
# directory for the whole project — so it has to be ignored, or `git status` is dirty while a
# stack lands and run.sh refuses to start on a dirty tree.
.agent/.land-worktree/

# Claude Code: personal settings stay out of the shared configuration.
.claude/settings.local.json

# Load harness output. The Gatling reports and the seeded ids both belong to one throwaway run
# against one throwaway database — SPEC-023.
tests/load/target/
tests/load/seed/out/

# Database dumps: real rows, real addresses, real password hashes — ADR-0044, subject V.8.
backups/

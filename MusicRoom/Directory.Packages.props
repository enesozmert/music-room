<Project>

  <!--
    Central package management. A version number appears exactly once in this solution.
    The set is fixed by brain/decisions/ADR-0021-backend-dependency-set.md.
    Adding a package is a decision, not a convenience.
    Never copy a version from reference/nArchitecture — that tree is net6 and stale.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="CQRS and validation — ADR-0021">
    <!-- MediatR >= 13.0.0 carries the LuckyPennySoftware commercial agreement. The free Community
         License covers this project; verified 2026-09-24, recorded in ADR-0021 Consequences. -->
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="API surface — ADR-0021">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Beyond the ADR-0021 list, approved at the SPEC-001 gate: build-time emission of
         docs/api/openapi.json. Build-only, Microsoft-owned, no runtime code. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Persistence — ADR-0021, ADR-0026">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Required by `dotnet ef migrations add` and `dotnet ef database update`. Named by no ADR;
         approved at the SPEC-002 gate on the same grounds as Microsoft.Extensions.ApiDescription.Server:
         Microsoft-owned, design-time only, no runtime code. Referenced with PrivateAssets="all".
         The version tracks the EF Core that Npgsql 10.0.3 brings in, not the newest published one:
         a Design package ahead of the runtime assemblies produces an MSB3277 conflict. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup Label="Security — ADR-0007, ADR-0021">
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup Label="Observability — ADR-0022">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup Label="Analyzers — ADR-0009">
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
  </ItemGroup>

  <ItemGroup Label="Tests — ADR-0012">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- ADR-0012 rejects the in-memory provider: it does not enforce a unique index, which is what
         the ux_users_email concurrency test has to prove. A real engine in a container does. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

</Project>

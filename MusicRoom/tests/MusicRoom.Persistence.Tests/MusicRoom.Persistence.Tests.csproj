<Project Sdk="Microsoft.NET.Sdk">

  <!-- The persistence layer of the testing standard. The schema-convention tests below build the
       model only, so they need no engine; mapping tests that need real SQL take Testcontainers. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MusicRoom/Persistence/MusicRoom.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>

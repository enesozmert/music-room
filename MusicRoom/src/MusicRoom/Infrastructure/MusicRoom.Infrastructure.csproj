<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- SPEC-035, ADR-0042. The breached-password set is compiled in rather than read from disk: a file beside
         the binary is a deployment step somebody can forget, and a missing screen that boots is worse than a
         boot that refuses. Data, not a dependency — nothing is added to Directory.Packages.props. -->
    <EmbeddedResource Include="Security/breached-passwords.txt" />

    <!-- The mail layout, one HTML and one text — SPEC-052. Embedded rather than copied beside the
         binary so a deployment cannot ship a message the build did not see. -->
    <EmbeddedResource Include="Messaging/Templates/Message.html" />
    <EmbeddedResource Include="Messaging/Templates/Message.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Application/MusicRoom.Application.csproj" />
    <ProjectReference Include="../../corePackages/Core.Security/Core.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0007. The choice is confined to this project: Application declares IPasswordHasher and
         never learns which algorithm implements it — ADR-0028. -->
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- SPEC-005 escalation 1, option B. Confined to this project: Application declares
         IAccessTokenIssuer and never learns which library signs the token — ADR-0028. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- SPEC-025. The catalog is an outbound HTTP call, and this gives it a typed client plus the
         timeout, retry and circuit breaker `youtube-integration` requires — ADR-0003. Confined to this
         project: Application declares ICatalogProvider and never learns that it is reached over HTTP. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- SPEC-024 gate 2. The hosted mail sender is an outbound HTTP call, and this is what gives it a
         typed client with a timeout the container configures — ADR-0013. Confined to this project:
         Application declares IMailService and never learns that a provider is reached over HTTP. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>

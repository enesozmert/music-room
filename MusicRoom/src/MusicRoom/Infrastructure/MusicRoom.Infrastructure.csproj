<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Application/MusicRoom.Application.csproj" />
    <ProjectReference Include="../../corePackages/Core.Security/Core.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0007. The choice is confined to this project: Application declares IPasswordHasher and
         never learns which algorithm implements it — ADR-0028. -->

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Edit(MusicRoom/**)",
      "Edit(MusicRoomApp/**)",
      "Edit(docs/specs/**)",
      "Edit(docs/api/**)",
      "Edit(docs/SDD.md)",
      "Edit(docs/owasp/THREAT-REGISTER.md)",
      "Edit(brain/migrations/migrations-index.md)",
      "Edit(brain/lessons/lessons-index.md)",
      "Edit(brain/project-registry.md)",
      "Bash(dotnet:*)",
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(shasum:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch:*)",
      "Bash(git push:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(reference/**)",
      "Edit(./.env)",
      "Edit(./.editorconfig)",
      "Edit(brain/decisions/**)",
      "Edit(docs/technical-guide/**)",
      "Edit(docs/owasp/upstream/**)",
      "Edit(.agent/permissions.json)",
      "Edit(.github/**)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:* -d *)",
      "Bash(claude:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --all:*)",
      "Bash(git push --tags:*)"
    ]
  },
  "_note": "Path-scoped rules use Edit(...) only; a Write(path) rule is silently ignored. Bash rules match a whole-command prefix, so a partial word such as 'git push -u origin feat/spec-' never matches — push is allowed broadly and the dangerous forms are denied instead. deny wins over allow. Branch protection on main with enforce_admins:true is the mechanism that actually stops a push to main; these rules are the first layer, not the last."
}
